<?xml version="1.0"?>
<package format="2">
  <name>rai_bringup</name>
  <version>0.0.1</version>
  <description>Bringup scripts and configurations for the RAI.</description>
  <maintainer email="maciej.majek@robotec.ai">Maciej Majek</maintainer>
  <license>Apache-2.0</license>

  <!-- Runtime dependencies of the rai_* Python packages, installed with rosdep. -->
  <exec_depend>rai_interfaces</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>tf2_geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>portaudio19-dev</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
